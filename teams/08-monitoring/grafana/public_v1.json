              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        },
        "xField": "step"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${ds}"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT step, run_id, value FROM metrics_raw WHERE name = 'loss_ntp' AND run_id IN ($run) AND value IS NOT NULL ORDER BY step",
          "refId": "A"
        }
      ],
      "title": "Training Loss (Next-Token)",
      "transformations": [
        {
          "id": "partitionByValues",
          "options": {
            "fields": [
              "run_id"
            ],
            "naming": {
              "asLabels": true
            }
          }
        },
        {
          "id": "joinByField",
          "options": {
            "byField": "step",
            "mode": "outer"
          }
        }
      ],
      "type": "trend"
    },
    {
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${ds}"
      },
      "description": "Smoothed next-token prediction loss averaged over fixed step buckets from ClickHouse rollups. Final public text to be confirmed by Team 11 Release and TSAI at Gate 3.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "showPoints": "auto"
          },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "id": 9,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        },
        "xField": "step"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${ds}"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT step_bucket AS step, run_id, mean AS value FROM metrics_rollup_${bucket} WHERE name = 'loss_ntp' AND run_id IN ($run) ORDER BY step_bucket",
          "refId": "A"
        }
      ],
      "title": "Training Loss (Step-Bucket Mean)",
      "transformations": [
        {
          "id": "partitionByValues",
          "options": {
            "fields": [
              "run_id"
            ],
            "naming": {
              "asLabels": true
            }
          }
        },
        {
          "id": "joinByField",
          "options": {
            "byField": "step",
            "mode": "outer"
          }
        }
      ],
      "type": "trend"
    },
    {
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${ds}"
      },
      "description": "Prediction loss measured on held-out text that the model does not train on, compared alongside training loss. Final public text to be confirmed by Team 11 Release and TSAI at Gate 3.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "axisLabel": "nats per token",
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": true
          },
          "decimals": 3,
          "unit": "none",
          "displayName": "${__field.labels.series}",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "step"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.axisLabel",
                "value": "step"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*validation_loss.*"
            },
            "properties": [
              {
                "id": "custom.showPoints",
                "value": "always"
              },
              {
                "id": "custom.pointSize",
                "value": 7
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              },
              {
                "id": "custom.spanNulls",
                "value": true
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "id": 20,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        },
        "xField": "step"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${ds}"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT x AS step, series, y AS value FROM (SELECT step AS x, concat(run_id, ' ', name) AS series, value AS y FROM metrics_raw WHERE name IN ('validation_loss', 'loss_ntp') AND run_id IN ($run) AND value IS NOT NULL UNION ALL SELECT step AS x, concat(run_id, ' validation_loss') AS series, sumIf(value, name = 'val/nll_nats') / sumIf(value, name = 'val/scored_tokens') AS y FROM metrics_raw WHERE name IN ('val/nll_nats', 'val/scored_tokens') AND run_id IN ($run) AND value IS NOT NULL GROUP BY run_id, step HAVING countIf(name = 'val/nll_nats') = 1 AND countIf(name = 'val/scored_tokens') = 1 AND sumIf(value, name = 'val/scored_tokens') > 0) ORDER BY step, series",
          "refId": "A"
        }
      ],
      "title": "Held-Out Validation Loss",
      "transformations": [
        {
          "id": "partitionByValues",
          "options": {
            "fields": [
              "series"
            ],
            "naming": {
              "asLabels": true
            }
          }
        },
        {
          "id": "joinByField",
          "options": {
            "byField": "step",
            "mode": "outer"
          }
        }
      ],
      "type": "trend"
    },
    {
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${ds}"
      },
      "description": "Held-out prediction loss normalized per UTF-8 byte rather than per token, allowing fair comparison across tokenizers and scripts. Final public text to be confirmed by Team 11 Release and TSAI at Gate 3.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "axisLabel": "bits per byte",
            "lineWidth": 2,
            "showPoints": "always",
            "spanNulls": true,
            "pointSize": 7
          },
          "decimals": 3,
          "unit": "none",
          "displayName": "${__field.labels.series}",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "step"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.axisLabel",
                "value": "step"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "id": 25,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        },
        "xField": "step"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${ds}"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT x AS step, series, y AS value FROM (SELECT step AS x, concat(run_id, ' validation_bpb') AS series, multiIf(countIf(name = 'validation_bpb') > 0, anyIf(value, name = 'validation_bpb'), countIf(name = 'val/bpb') > 0, anyIf(value, name = 'val/bpb'), countIf(name = 'val/nll_nats') = 1 AND countIf(name = 'val/utf8_bytes') = 1 AND sumIf(value, name = 'val/utf8_bytes') > 0, sumIf(value, name = 'val/nll_nats') / (log(2) * sumIf(value, name = 'val/utf8_bytes')), NULL) AS y FROM metrics_raw WHERE name IN ('validation_bpb', 'val/bpb', 'val/nll_nats', 'val/utf8_bytes') AND run_id IN ($run) AND value IS NOT NULL GROUP BY run_id, step) WHERE y IS NOT NULL ORDER BY step, series",
          "refId": "A"
        }
      ],
      "title": "Held-Out Validation Bits per Byte",
      "transformations": [
        {
          "id": "partitionByValues",
          "options": {
            "fields": [
              "series"
            ],
            "naming": {
              "asLabels": true
            }
          }
        },
        {
          "id": "joinByField",
          "options": {
            "byField": "step",
            "mode": "outer"
          }
        }
      ],
      "type": "trend"
    },
